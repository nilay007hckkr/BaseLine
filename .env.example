# ---- storage ----
DATA_DIR=./data
DB_PATH=./data/hindsight.db

# ---- target system ----
# repository to ingest (default: Google Online Boutique upstream); phase 2 uses your fork
TARGET_REPO_URL=
TARGET_URL=http://localhost:8081
KIND_CLUSTER_NAME=hs-target

# ---- forge ----
# optional, fine-grained, read-only; without it GitHub allows 60 requests/hour
GITHUB_TOKEN=
# GitHub API requests per ingest run (pages are cached; the next run resumes)
FORGE_MAX_REQUESTS=50

# ---- LLM chain ----
LLM_PROVIDER_ORDER=gemini,groq,ollama
# off | record | replay | read-through
LLM_CACHE_MODE=read-through
LLM_ALLOW_EXTERNAL=true
DOCS_ALLOW_EXTERNAL=false
LLM_DAILY_REQUEST_CAP=500
GEMINI_API_KEY=
# pick from AI Studio's current free-tier list
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OLLAMA_HOST=http://localhost:11434
# local models (ollama pull …): a ~4B chat model fits next to other GPU users on 6 GB
OLLAMA_CHAT_MODEL=gemma3:4b
# semantic search over the project's history; build the index with `make embed`
OLLAMA_EMBED_MODEL=nomic-embed-text
# a configured model re-checks that each cited text supports its claim (can only remove claims)
ANSWER_SUPPORT_CHECK=true

# ---- graph layer (optional, `make graph-up`) ----
# auto: Neo4j when it is running and in sync with SQLite, else SQLite | sqlite | neo4j
GRAPH_BACKEND=auto
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# leave empty to use the password scripts/graph.sh generates into data/neo4j/password
NEO4J_PASSWORD=

# ---- alerts ----
# Discord webhook
ALERT_WEBHOOK_URL=

# ---- api ----
API_HOST=127.0.0.1
API_PORT=8000

# ---- instances (scripts/run.sh sets these; leave empty for a single demo instance) ----
# demo | workspace (an empty instance where you connect your own GitHub repository)
HINDSIGHT_MODE=
# where a workspace finds the demo, whose API its tour uses
DEMO_PORT=8000
# browser origins allowed to call this API, comma-separated
CORS_ORIGINS=
